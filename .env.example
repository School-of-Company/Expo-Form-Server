PORT=3000

# postgres://<user>:<password>@<host>:<port>/<database> — see docker-compose.yml for local defaults
DATABASE_URL=postgres://app:app@localhost:5432/expoform

# production에서만 사용. 인증서 체인을 신뢰할 수 없는 DB 제공자에 한해 'false'로 설정 (기본값: true, 인증서 검증)
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# 앱 시작/종료·처리되지 않은 예외를 알릴 Discord 웹훅 URL. 미설정 시 알림 자동 비활성화 (dicoshot-nest)
DISCORD_WEBHOOK_URL=

# 콤마로 구분한 Kafka 브로커 목록 — see docker-compose.yml for local defaults
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=expo-form-server

# 설문 답변 접수 발행/결과 토픽 (#29 — 아웃박스 → Kafka 비동기 전환)
KAFKA_SURVEY_ANSWER_SUBMIT_TOPIC=survey.answer.submit
KAFKA_SURVEY_ANSWER_RESULT_TOPIC=survey.answer.result
KAFKA_SURVEY_ANSWER_RESULT_GROUP_ID=expo-form-server.survey-answer-result

# PUBLISHED 상태로 이만큼(ms) 지나면 결과를 못 받은 것으로 보고 재발행한다 (기본 5분)
SURVEY_ANSWER_STALE_MS=300000
# 재발행 상한 횟수 — 이 이상 넘어가면 더 이상 재발행하지 않고 사람이 봐야 할 대상으로 남긴다
SURVEY_ANSWER_MAX_RETRY_COUNT=5

# 유저 서비스 내부 API 주소 — 설문 답변 응답자 확인(POST /internal/participants/resolve)에 쓴다. 끝에 / 없이
USER_SERVICE_URL=http://localhost:8080
# 유저 서비스가 /internal 경로를 보호하는 공유 시크릿(X-Internal-Token)의 사본. 유저 서비스의 INTERNAL_TOKEN과
# 같은 값이어야 하고 32자 이상이다. 값은 여기 적지 않는다 — 생성: openssl rand -hex 32
USER_SERVICE_INTERNAL_TOKEN=

# 참여 서비스 내부 API 주소 — 현장 종이 QR 토큰의 입장 확인(POST /internal/qr-tokens/resolve)에 쓴다. 끝에 / 없이
# 참여 서비스가 배포되기 전에는 둘 다 비워 둔다(이 경우 현장 QR 설문 API만 503). 하나만 넣으면 부팅이 실패한다.
PARTICIPATION_SERVICE_URL=
# 참여 서비스가 /internal 경로를 보호하는 공유 시크릿(X-Internal-Token)의 사본. 32자 이상, 값은 여기 적지 않는다
PARTICIPATION_SERVICE_INTERNAL_TOKEN=
