PORT=3000

# postgres://<user>:<password>@<host>:<port>/<database> — see docker-compose.yml for local defaults
DATABASE_URL=postgres://app:app@localhost:5432/expoform

# production에서만 사용. 인증서 체인을 신뢰할 수 없는 DB 제공자에 한해 'false'로 설정 (기본값: true, 인증서 검증)
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# 앱 시작/종료·처리되지 않은 예외를 알릴 Discord 웹훅 URL. 미설정 시 알림 자동 비활성화 (dicoshot-nest)
DISCORD_WEBHOOK_URL=

# 콤마로 구분한 Kafka 브로커 목록 — see docker-compose.yml for local defaults
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=expo-form-server

# 설문 답변 접수 발행/결과 토픽 (#29 — 아웃박스 → Kafka 비동기 전환)
KAFKA_SURVEY_ANSWER_SUBMIT_TOPIC=survey.answer.submit
KAFKA_SURVEY_ANSWER_RESULT_TOPIC=survey.answer.result
KAFKA_SURVEY_ANSWER_RESULT_GROUP_ID=expo-form-server.survey-answer-result
# 경품 당첨 결과(DRAW_RESULT)를 알림 서비스로 보내는 토픽. 비우면 notification.sms.requested
KAFKA_SMS_REQUESTED_TOPIC=notification.sms.requested
# 경품 당첨자 전화번호를 박람회 종료 후 며칠 동안 보관할지(1 이상의 정수, 기본 30). 지나면 번호만 지우고 당첨 순번 기록은 남긴다.
LOTTERY_PHONE_RETENTION_DAYS=30

# 릴레이 주기(ms, 기본 30000)와 한 주기에 잠글 건수(RECEIVED·재발행 각각, 기본 100), Kafka sendBatch 한 번에 묶을 건수(기본 50)
SURVEY_ANSWER_RELAY_INTERVAL_MS=30000
SURVEY_ANSWER_RELAY_BATCH_SIZE=100
SURVEY_ANSWER_RELAY_SEND_BATCH_SIZE=50
# PUBLISHED 상태로 이만큼(ms) 지나면 결과를 못 받은 것으로 보고 재발행한다 (기본 5분). 재발행할 때마다 두 배씩 늘어난다
SURVEY_ANSWER_STALE_MS=300000
# 재발행 간격 상한(ms, 기본 30분)과 간격에 더할 지터 최대 비율(0~1, 기본 0.2)
SURVEY_ANSWER_STALE_MAX_MS=1800000
SURVEY_ANSWER_STALE_JITTER_RATIO=0.2
# 설문 답변 이벤트 버전. 1은 기존 모양, 2는 제출 당시의 문항 스냅샷(`questions`)을 함께 싣는다(#65).
# 유저 서비스 컨슈머가 v2를 받도록 먼저 배포된 뒤에 2로 올릴 것(기본 1). 2여도 스냅샷이 없는 옛 접수 건은 v1로 보낸다
SURVEY_ANSWER_EVENT_VERSION=1
# 재발행 상한 횟수 — 이 이상 넘어가면 더 이상 재발행하지 않고 사람이 봐야 할 대상으로 남긴다
SURVEY_ANSWER_MAX_RETRY_COUNT=5
# 재발행 상한을 다 쓴 답변을 유저 서비스에 매시간 다시 확인하는 정합성 점검. 정확히 `true`일 때만 켜진다(기본 꺼짐).
# 유저 서비스의 처리 결과 조회 API(Expo-User-Server#11)가 배포된 뒤에 켤 것
SURVEY_ANSWER_RECONCILE_ENABLED=

# 유저 서비스 내부 API 주소 — 설문 답변 응답자 확인(POST /internal/participants/resolve)에 쓴다. 끝에 / 없이
USER_SERVICE_URL=http://localhost:8080
# 유저 서비스가 /internal 경로를 보호하는 공유 시크릿(X-Internal-Token)의 사본. 유저 서비스의 INTERNAL_TOKEN과
# 같은 값이어야 하고 32자 이상이다. 값은 여기 적지 않는다 — 생성: openssl rand -hex 32
USER_SERVICE_INTERNAL_TOKEN=
# 설문 답변 제출(POST /surveys/answer/{standard|trainee}/{expoId})이 읽는 참가자 세션 쿠키 이름. 유저 서비스가 발급하는
# 쿠키 이름(신청 서비스의 PARTICIPANT_SESSION_COOKIE_NAME)과 같아야 한다. 비우면 PARTICIPANT_SESSION
PARTICIPANT_SESSION_COOKIE_NAME=

# 박람회 서비스 내부 API 주소 — 폼·설문 생성 때 박람회가 있는지 확인한다(GET /internal/expo/{expoId}). 끝에 / 없이
# 둘 다 비워 두면 확인을 건너뛴다(연동 전과 같은 동작). 하나만 넣으면 부팅이 실패한다.
EXPO_SERVICE_URL=
# 박람회 서비스가 /internal 경로를 보호하는 공유 시크릿(X-Internal-Token)의 사본. 박람회 서비스의 EXPO_INTERNAL_TOKEN과
# 같은 값이어야 하고 32자 이상이다. 값은 여기 적지 않는다
EXPO_SERVICE_INTERNAL_TOKEN=

# 박람회 조회(폼·설문 생성 때 존재 확인, 당첨 번호 보관 기간의 박람회 기간)를 박람회 서비스 동기 호출 대신 로컬 프로젝션에서 읽는다.
# 프로젝션은 박람회 서비스의 `expo.expo.changed` 이벤트(Expo-Expo-Server#212)로 채운다. 정확히 `true`일 때만 켜진다(기본 꺼짐 = 지금처럼 동기 조회).
# 켜면 컨슈머가 토픽을 구독하고, 프로젝션에 아직 없는 박람회는 위 박람회 서비스 API로 동기 조회한다. 처음 켠 뒤에는 박람회 서비스의
# POST /internal/expo-events/republish로 전체 상태를 한 번 다시 싣는다. 폼 변경 예약·해제는 켜도 동기 호출이다.
KAFKA_EXPO_PROJECTION_ENABLED=
# 박람회 변경 이벤트 토픽(기본 expo.expo.changed)과 컨슈머 그룹(기본 expo-form-server.expo-changed).
# 해석하지 못하거나 3번 반영에 실패한 메시지는 `<토픽>.dlt`로 보낸다 — 운영에서 미리 만들어 둔다
KAFKA_EXPO_CHANGED_TOPIC=expo.expo.changed
KAFKA_EXPO_CHANGED_GROUP_ID=expo-form-server.expo-changed

# 다른 서비스가 이 서비스의 /internal 경로(폼·설문 조회, 박람회별 현황, 박람회 일괄 삭제)를 부를 때 X-Internal-Token으로
# 보내야 하는 공유 시크릿. 필수이며 32자 이상이고, 없으면 부팅이 실패한다. 값은 여기 적지 않는다 — 생성: openssl rand -hex 32
INTERNAL_TOKEN=

# Eureka 등록 (Gateway가 /forms, /surveys 를 expo-form-server 로 라우팅). 비워 두면 등록하지 않는다 — 로컬 개발은 그대로 두면 된다.
# 쉼표로 여러 서버를 줄 수 있다. 값이 있으면 INSTANCE_HOSTNAME, INSTANCE_IP_ADDR 도 필요하다 (Gateway 와 같은 이름).
EUREKA_SERVICE_URL=
INSTANCE_HOSTNAME=
INSTANCE_IP_ADDR=

# 게이트웨이 통합 API 문서(Expo-Gateway#30)용 OpenAPI 노출. 정확히 `true`일 때만 켜진다(기본 꺼짐, 선택이라 없어도 부팅에 영향 없음).
# 켜면 UI는 /forms/docs, JSON은 /forms/v3/api-docs 에서 나간다. 꺼져 있으면 두 경로 모두 404다.
SWAGGER_ENABLED=
# 문서에 /internal/** 경로를 포함할지. 정확히 `true`일 때만 포함한다(기본 제외). 포함해도 X-Internal-Token 값은 적지 않는다.
SWAGGER_INCLUDE_INTERNAL=

# 공통 메트릭 규약(Expo-Config-Server docs/metrics-convention.md, Expo-Gateway#12). 서비스 포트(PORT)와 분리된 listener에서
# GET /metrics만 응답한다. false면 listener를 열지 않고 Eureka에 수집 metadata도 싣지 않는다(기본 true).
METRICS_ENABLED=
# 기본 127.0.0.1(loopback)이라 외부에 열리지 않는다. Prometheus가 인스턴스 IP로 수집하러 오므로, Eureka metadata를 싣으려면
# INSTANCE_IP_ADDR와 같은 사설 IP 또는 0.0.0.0(방화벽 안쪽)이어야 한다. 외부 publish 금지.
METRICS_HOST=
# 기본 9464. 같은 서버의 다른 서비스와 겹치면 안 된다 — 포트를 열지 못하면 서비스는 뜨지만 수집 등록은 하지 않는다.
METRICS_PORT=

# DB 연결 풀·타임아웃(모두 선택, 비워 두면 pg 기본값: 풀 10개, 연결 대기 무제한, 쿼리 제한 없음). 현장 트래픽에서 공개 설문 제출이 설문 행
# 락을 두고 줄을 서면 대기자가 풀을 다 차지할 수 있으니, 운영에서는 연결 대기와 트랜잭션 대기에 상한을 두는 것을 권한다.
# 지표 `form_db_pool_connections{state="waiting"}`가 계속 0보다 크면 풀이 고갈된 것이다.
DB_POOL_MAX=
# 풀에서 연결을 얻기까지 기다리는 최대 시간(ms). 예: 5000
DB_CONNECTION_TIMEOUT_MS=
# 쿼리 하나의 최대 실행 시간(ms). 예: 30000
DB_STATEMENT_TIMEOUT_MS=
# 트랜잭션을 연 채 아무것도 하지 않는 최대 시간(ms). 릴레이가 Kafka를 기다리며 락을 쥐는 시간의 상한. 예: 120000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=

# 하위 서비스(박람회·유저) 호출 보호. 최근 WINDOW_MS 동안 호출이 MIN_CALLS번 이상이고 실패율이 FAILURE_RATE(%)를 넘으면
# 회로가 열려 HALF_OPEN_MS 동안 호출하지 않고 바로 503을 돌려준다. 호출이 적을 때 몇 번의 실패로 열리지 않게 하려는 것이다.
# 재시도는 멱등한 GET의 즉시 실패(5xx·연결 실패)에만 하고, 타임아웃과 쓰기 호출은 재시도하지 않는다.
DOWNSTREAM_BREAKER_MIN_CALLS=10
DOWNSTREAM_BREAKER_FAILURE_RATE=50
DOWNSTREAM_BREAKER_WINDOW_MS=30000
DOWNSTREAM_BREAKER_HALF_OPEN_MS=30000
DOWNSTREAM_RETRY_ATTEMPTS=1
# 서비스별 동시 호출 상한(벌크헤드). 하위 서비스가 느려져도 그쪽 호출이 연결을 다 차지하지 못하게 한다.
# 동시 MAX_CONCURRENT개를 넘으면 MAX_QUEUE개까지 기다리고, 그 이상은 바로 503이다.
DOWNSTREAM_BULKHEAD_MAX_CONCURRENT=20
DOWNSTREAM_BULKHEAD_MAX_QUEUE=10

# 요청마다 `GET /forms/:id status: 200 (12ms)` 형태의 접근 로그를 남긴다(module=HttpAccess, 4xx는 WARN, 5xx·499는 ERROR).
# 쿼리·헤더·본문은 남기지 않는다. false면 끈다.
HTTP_ACCESS_LOG_ENABLED=true
