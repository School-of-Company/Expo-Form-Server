#!/usr/bin/env bash
# 커밋하는 JS/TS 파일만 XO로 검사한다. CI에서는 린트를 돌리지 않는다.
# 설치: pnpm install 때 `prepare` 스크립트가 core.hooksPath를 .githooks로 맞춘다. 급할 때는 git commit --no-verify.
set -euo pipefail

files=()
while IFS= read -r file; do
  files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.js' '*.mjs' '*.cjs')
[[ ${#files[@]} -eq 0 ]] && exit 0

pnpm exec xo "${files[@]}"
